{
  "Wrap in try/except": {
    "prefix": "wraptry",
    "body": [
      "try:",
      "\t${TM_SELECTED_TEXT}",
      "except ${1:Exception} as ${2:exc}:",
      "\t${3:raise}"
    ],
    "description": "Wrap selection in try/except"
  },
  "Wrap in try/finally": {
    "prefix": "wraptryfinally",
    "body": ["try:", "\t${TM_SELECTED_TEXT}", "finally:", "\t${1:pass}"],
    "description": "Wrap selection in try/finally"
  },
  "Wrap in if": {
    "prefix": "wrapif",
    "body": ["if ${1:condition}:", "\t${TM_SELECTED_TEXT}"],
    "description": "Wrap selection in an if block"
  },
  "Wrap in for": {
    "prefix": "wrapfor",
    "body": ["for ${1:item} in ${2:iterable}:", "\t${TM_SELECTED_TEXT}"],
    "description": "Wrap selection in a for loop"
  },
  "Wrap in while": {
    "prefix": "wrapwhile",
    "body": ["while ${1:condition}:", "\t${TM_SELECTED_TEXT}"],
    "description": "Wrap selection in a while loop"
  },
  "Wrap in function": {
    "prefix": "wrapdef",
    "body": ["def ${1:name}(${2:args}) -> ${3:None}:", "\t${TM_SELECTED_TEXT}"],
    "description": "Extract selection into a function body"
  },
  "Wrap in main guard": {
    "prefix": "wrapmain",
    "body": ["if __name__ == \"__main__\":", "\t${TM_SELECTED_TEXT}"],
    "description": "Wrap selection in a __main__ guard"
  },
  "Wrap in with open": {
    "prefix": "wrapwith",
    "body": [
      "with open(${1:path}, \"${2:r}\", encoding=\"utf-8\") as ${3:f}:",
      "\t${TM_SELECTED_TEXT}"
    ],
    "description": "Wrap selection in a with open block"
  },
  "Wrap in suppress": {
    "prefix": "wrapsuppress",
    "body": [
      "with contextlib.suppress(${1:Exception}):",
      "\t${TM_SELECTED_TEXT}"
    ],
    "description": "Wrap selection in contextlib.suppress"
  },
  "Wrap in pytest.raises": {
    "prefix": "wrapraises",
    "body": ["with pytest.raises(${1:ValueError}):", "\t${TM_SELECTED_TEXT}"],
    "description": "Wrap selection in a pytest.raises block"
  },
  "Wrap in timing block": {
    "prefix": "wraptimeit",
    "body": [
      "_t0 = time.perf_counter()",
      "${TM_SELECTED_TEXT}",
      "print(f\"${1:block} took {time.perf_counter() - _t0:.3f}s\")"
    ],
    "description": "Time the selected block"
  },
  "Wrap in debug print": {
    "prefix": "wrapdebug",
    "body": "print(f\"{${TM_SELECTED_TEXT}=}\")",
    "description": "Wrap an expression in an f-string debug print"
  }
}
