  // Git settings
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "gitlens.currentLine.uncommittedChangesFormat": "✏️ ${ago}",
  "gitlens.codeLens.scopes": ["document", "containers", "blocks"],
  "gitlens.currentLine.format": "${author👤}${ • agoOrDate📅}${ • 'via 'pullRequest 🔀 }${ • message|50💬 }",

  // Experimental settings
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
    "asvetliakov.vscode-neovim": 1,
  },

  // Other settings
  "commands.commands": {
    "openFileAndCloseExplorer": {
      "sequence": [
        {
          "command": "filesExplorer.openFilePreserveFocus",
          "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus",
        },
        {
          "command": "workbench.action.closeSidebar",
          "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus",
        },
      ],
    },
    "openFileToTheSideAndCloseExplorer": {
      "sequence": [
        {
          "command": "explorer.openToSide",
          "when": "explorerViewletVisible && explorerViewletFocus && !explorerResourceIsFolder && !inputFocus",
        },
        {
          "command": "workbench.action.closeSidebar",
          "when": "explorerViewletVisible && !explorerResourceIsFolder && !inputFocus",
        },
      ],
    },
  },
